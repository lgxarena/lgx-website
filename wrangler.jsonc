// Hospedagem no Cloudflare Workers: as páginas são arquivos estáticos; só o painel de edição
// (/keystatic e /api/keystatic) roda código no Worker (adaptador @astrojs/cloudflare).
// A branch `main` publica o site oficial; as outras viram previews (ver issue #25).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lgx-website",
  "account_id": "4ee37d62a8edcdb70dcbd2a573b3d4ad",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist",
    // /precos serve dist/precos.html; endereço inexistente mostra o 404.html com status 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Sem isto, abrir /keystatic no navegador cairia no 404 antes de chegar ao Worker.
    "run_worker_first": ["/keystatic", "/keystatic/*", "/api/keystatic/*"],
  },
  "preview_urls": true,
  // Cada branch e PR ganha um preview próprio (fora do Google; ver src/lib/config.ts).
  "previews": {},
  "observability": { "enabled": true },
}
