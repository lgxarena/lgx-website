---
import CabecalhoEventos from '@/components/eventos/CabecalhoEventos.astro'
import BotaoReservar from '@/components/ui/BotaoReservar.astro'
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import Icon from '@/components/ui/Icon.astro'
import Placeholder from '@/components/ui/Placeholder.astro'
import Base from '@/layouts/Base.astro'
import { getCampeonatos, getSite } from '@/lib/conteudo'
import { formatarPreco } from '@/lib/formatar'

const [site, { proximos, anteriores }] = await Promise.all([getSite(), getCampeonatos()])

const fuso = 'America/Sao_Paulo'
const dia = (data: Date) => data.toLocaleDateString('pt-BR', { day: '2-digit', timeZone: fuso })
const mes = (data: Date) =>
  data.toLocaleDateString('pt-BR', { month: 'short', timeZone: fuso }).replace('.', '')
const ano = (data: Date) => data.toLocaleDateString('pt-BR', { year: 'numeric', timeZone: fuso })

const titulo2 = 'text-[28px] font-extrabold'
---

<Base
  title="Campeonatos"
  description="LGX CUP e Liga SP: próximos campeonatos, inscrições, ranking e campeões anteriores da LGX Arena."
>
  <Container class="flex flex-col gap-16 pt-10 pb-24 md:pt-14 md:pb-28">
    <CabecalhoEventos
      titulo="Campeonatos"
      descricao="Organizamos a LGX CUP e torneios regionais como a Liga SP. Tudo também sai no Instagram e na Twitch."
    />

    <section aria-labelledby="proximos" class="flex flex-col gap-6">
      <h2 id="proximos" class={titulo2}>
        Próximos
      </h2>
      {proximos.length > 0 ? (
        <ul class="flex flex-col gap-3">
          {proximos.map(({ data: campeonato }) => {
            const detalhes = [
              campeonato.formato,
              campeonato.inscricao !== undefined &&
                `inscrição ${formatarPreco(campeonato.inscricao)}`,
              campeonato.premio && `prêmio ${campeonato.premio}`,
            ].filter(Boolean)
            return (
              <li class="flex flex-wrap items-center gap-x-6 gap-y-4 rounded-lg bg-surface p-5 sm:p-6">
                <time
                  datetime={campeonato.data.toISOString().slice(0, 10)}
                  class="flex w-16 shrink-0 flex-col items-center rounded-md bg-surface-2 py-2 leading-none"
                >
                  <span class="text-2xl font-extrabold tabular-nums">{dia(campeonato.data)}</span>
                  <span class="mt-1 text-xs font-bold tracking-[0.12em] text-link uppercase">
                    {mes(campeonato.data)}
                  </span>
                </time>
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <h3 class="text-lg font-bold">
                    {campeonato.nome} · {campeonato.jogo}
                  </h3>
                  {detalhes.length > 0 && (
                    <p class="text-[15px] text-fg-muted">{detalhes.join(' · ')}</p>
                  )}
                </div>
                {campeonato.linkInscricao ? (
                  <Button href={campeonato.linkInscricao} target="_blank" rel="noopener">
                    Inscrever time{' '}
                    <span class="sr-only">no {campeonato.nome} (abre em nova aba)</span>
                  </Button>
                ) : (
                  <BotaoReservar
                    mensagem={`Olá! Quero inscrever meu time no ${campeonato.nome} (${campeonato.jogo}).`}
                  >
                    Inscrever time
                  </BotaoReservar>
                )}
              </li>
            )
          })}
        </ul>
      ) : (
        <div class="flex flex-wrap items-center justify-between gap-4 rounded-lg bg-surface px-6 py-5">
          <p class="text-[17px]">
            Nenhum campeonato com data marcada agora.{' '}
            <span class="text-fg-muted">As próximas datas saem primeiro no Instagram.</span>
          </p>
          <Button href={site.redes.instagram} target="_blank" rel="noopener" variant="secondary">
            <Icon name="instagram" /> Seguir no Instagram
            <span class="sr-only">(abre em nova aba)</span>
          </Button>
        </div>
      )}
    </section>

    <section
      aria-labelledby="ranking"
      class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 rounded-lg bg-surface-2 px-6 py-6 sm:px-8"
    >
      <div class="flex flex-col gap-1">
        <h2 id="ranking" class="text-xl font-bold">
          Ranking e estatísticas
        </h2>
        <p class="text-[15px] text-fg-muted">
          Suas partidas na LGX, sua posição no ranking e as estatísticas de cada jogador.
        </p>
      </div>
      <Button href={site.rank} target="_blank" rel="noopener" variant="inverse">
        Abrir o Rank <Icon name="external-link" size={16} />
        <span class="sr-only">(abre em nova aba)</span>
      </Button>
    </section>

    {anteriores.length > 0 && (
      <section aria-labelledby="campeoes" class="flex flex-col gap-6">
        <h2 id="campeoes" class={titulo2}>
          Campeões anteriores
        </h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {anteriores.map(({ data: campeonato }) => (
            <li class="flex flex-col gap-1 rounded-lg bg-surface p-6">
              <span class="text-sm text-fg-muted">
                {campeonato.nome} · {campeonato.jogo} · {mes(campeonato.data)}{' '}
                {ano(campeonato.data)}
              </span>
              <b class="text-lg">{campeonato.campeao}</b>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="grid grid-cols-2 gap-3 md:grid-cols-3">
      <Placeholder label="Final" class="h-40 md:h-56" />
      <Placeholder label="Premiação" class="h-40 md:h-56" />
      <Placeholder label="Transmissão" class="h-40 max-md:col-span-2 md:h-56" />
    </div>

    <section
      aria-labelledby="seu-campeonato"
      class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 rounded-lg bg-surface px-6 py-5"
    >
      <div class="flex flex-col gap-0.5">
        <h2 id="seu-campeonato" class="text-lg font-bold">
          Quer fazer o seu campeonato aqui?
        </h2>
        <p class="text-[15px] text-fg-muted">
          Servidores dedicados, internet de 2 Gbps e sala de stream.
        </p>
      </div>
      <Button href="/empresas" variant="secondary">
        Ver eventos para empresas e times <Icon name="arrow-right" size={18} />
      </Button>
    </section>
  </Container>
</Base>
