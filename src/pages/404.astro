---
import Button from '@/components/ui/Button.astro'
import Base from '@/layouts/Base.astro'

const atalhos = [
  { rotulo: 'Jogos', href: '/jogos' },
  { rotulo: 'Corujão', href: '/corujao' },
  { rotulo: 'Perguntas frequentes', href: '/faq' },
]
---

<Base
  title="Página não encontrada"
  description="Esta página não existe ou mudou de endereço."
  noindex
>
  <div class="container-page flex max-w-180 flex-col items-center gap-5 py-24 text-center md:py-32">
    <p
      aria-hidden="true"
      class="text-[80px] leading-none font-extrabold tracking-[-0.04em] text-accent md:text-[96px]"
    >
      404
    </p>
    <h1 class="text-3xl font-extrabold md:text-4xl">Game Over!</h1>
    <p class="text-lg leading-relaxed text-fg-muted">
      Parece que você foi para um mapa secreto… e ele não existe.
    </p>
    <div class="mt-2 grid w-full gap-3 sm:flex sm:w-auto sm:justify-center">
      <Button href="/">Voltar ao início</Button>
      <Button href="/precos" variant="secondary">
        Ver preços
      </Button>
    </div>
    <p class="mt-4 text-[15px] text-fg-muted">
      Procurando algo?{' '}
      {atalhos.map((atalho, indice) => (
        <>
          {indice > 0 && ' · '}
          <a href={atalho.href}>{atalho.rotulo}</a>
        </>
      ))}
    </p>
  </div>
</Base>
