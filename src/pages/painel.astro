---
/**
 * Entrada do painel de edição (#26). Quem abre /keystatic sem estar logado cai aqui
 * (src/middleware.ts); o botão leva ao login do GitHub e volta direto para o painel.
 * Página só para a equipe: fora do Google e do sitemap, sem cabeçalho e rodapé do site.
 */
import { Font } from 'astro:assets'

import Brand from '@/components/layout/Brand.astro'
import Icon, { type IconName } from '@/components/ui/Icon.astro'
import { MODO_PAINEL_GITHUB } from '@/lib/painel'

import '@/styles/global.css'

const entrar = MODO_PAINEL_GITHUB ? '/api/keystatic/github/login' : '/keystatic'
const oQueDaParaEditar: { nome: string; icone: IconName }[] = [
  { nome: 'Preços e pacotes', icone: 'tag' },
  { nome: 'Horários e avisos', icone: 'clock' },
  { nome: 'Jogos e cardápio', icone: 'gamepad' },
  { nome: 'FAQ e regras', icone: 'help' },
]
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Painel · LGX Arena</title>
    <meta name="description" content="Área da equipe para editar o site da LGX Arena." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0e0e0e" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body class="flex min-h-dvh flex-col items-center justify-center px-4 py-12">
    <main class="flex w-full max-w-md flex-col gap-8">
      <a href="/" class="self-center" aria-label="Ir para o site da LGX Arena">
        <Brand width={176} />
      </a>

      <div class="relative flex flex-col gap-6 overflow-hidden rounded-xl border border-line bg-surface p-6 sm:p-8">
        {/* Filete vermelho no topo do cartão. */}
        <div
          aria-hidden="true"
          class="absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,var(--color-accent),transparent)]"
        ></div>

        <div class="flex flex-col gap-2">
          <h1 class="text-2xl font-extrabold tracking-tight">Painel do site</h1>
          <p class="leading-relaxed text-fg-muted">
            Atualize o site sem depender de ninguém. Cada alteração salva entra no ar em cerca de 1
            minuto.
          </p>
        </div>

        <ul class="grid grid-cols-2 gap-2 text-[15px]">
          {oQueDaParaEditar.map((item) => (
            <li class="flex items-center gap-2 text-fg-soft">
              <Icon name={item.icone} size={16} class="shrink-0 text-accent" />
              {item.nome}
            </li>
          ))}
        </ul>

        <a
          href={entrar}
          class="inline-flex min-h-12 items-center justify-center gap-3 rounded-md bg-fg px-5 font-semibold text-bg no-underline transition-colors hover:bg-white hover:text-bg"
        >
          <Icon name="github" size={20} />
          Entrar com GitHub
        </a>

        <p class="border-t border-line pt-5 text-sm leading-relaxed text-fg-muted">
          Só contas com acesso liberado pela LGX conseguem entrar. Se der erro, peça ao
          administrador para adicionar a sua conta do GitHub.
        </p>
      </div>

      <a href="/" class="self-center text-sm text-fg-muted transition-colors hover:text-fg">
        Voltar para o site
      </a>
    </main>
  </body>
</html>
