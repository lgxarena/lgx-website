---
/**
 * Catálogo de tokens e componentes para revisão no preview.
 * Não entra no menu nem no sitemap; remover ou proteger antes da virada (#25).
 */
import Button from '@/components/ui/Button.astro'
import Card from '@/components/ui/Card.astro'
import Icon, { type IconName } from '@/components/ui/Icon.astro'
import Placeholder from '@/components/ui/Placeholder.astro'
import Section from '@/components/ui/Section.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import Stars from '@/components/ui/Stars.astro'
import Tag from '@/components/ui/Tag.astro'
import Base from '@/layouts/Base.astro'
import { getHorarios, getJogos, getMenorPrecoPorHora, getPlanos, getSalas } from '@/lib/conteudo'
import { formatarHora, formatarPreco } from '@/lib/formatar'

const [salas, planos, horarios, jogos] = await Promise.all([
  getSalas(),
  getPlanos(),
  getHorarios(),
  getJogos(),
])
const aPartirDe = {
  pro: await getMenorPrecoPorHora('pro'),
  vip: await getMenorPrecoPorHora('vip'),
}

const cores = [
  { grupo: 'Fundos', itens: ['bg', 'bg-alt', 'surface', 'surface-2', 'surface-3'] },
  { grupo: 'Linhas', itens: ['line', 'line-strong', 'placeholder'] },
  { grupo: 'Texto', itens: ['fg', 'fg-soft', 'fg-muted', 'fg-subtle'] },
  {
    grupo: 'Marca',
    itens: ['accent', 'accent-strong', 'accent-deep', 'accent-tint', 'link', 'link-hover'],
  },
]

const icones: IconName[] = [
  'whatsapp',
  'instagram',
  'tiktok',
  'twitch',
  'youtube',
  'facebook',
  'chevron-left',
  'chevron-right',
  'chevron-down',
  'arrow-right',
  'external-link',
  'check',
  'menu',
  'close',
  'map-pin',
  'phone',
  'clock',
  'search',
]
---

<Base title="Componentes · LGX Arena">
  <main>
    <Section spacing="md">
      <SectionHeading
        as="h1"
        title="Componentes"
        description="Tokens de design e componentes base do novo site. Página interna de revisão."
      />
    </Section>

    <Section tone="alt" aria-labelledby="cores">
      <SectionHeading id="cores" title="Cores" />
      <div class="grid gap-8 md:grid-cols-2">
        {cores.map(({ grupo, itens }) => (
          <div class="flex flex-col gap-3">
            <h3 class="text-sm font-bold tracking-widest text-fg-muted uppercase">{grupo}</h3>
            <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
              {itens.map((nome) => (
                <li class="flex flex-col gap-2">
                  <span
                    class="h-16 rounded-md border border-line"
                    style={`background: var(--color-${nome})`}
                  />
                  <code class="text-sm text-fg-soft">{nome}</code>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </Section>

    <Section aria-labelledby="tipografia">
      <SectionHeading id="tipografia" title="Tipografia" description="Inter, pesos de 400 a 800." />
      <div class="flex flex-col gap-4">
        <p class="text-6xl leading-none font-extrabold tracking-tight md:text-[88px]">
          ONDE OS GAMERS
        </p>
        <p class="text-[40px] font-extrabold tracking-tight">Título de seção</p>
        <p class="text-2xl font-bold">Título de cartão</p>
        <p class="max-w-2xl text-[17px] leading-relaxed text-fg-soft">
          Texto corrido em 17px, com entrelinha confortável. Duas salas, Pro e VIP, com PCs prontos
          para competir. <a href="#tipografia">Link no texto</a>.
        </p>
        <p class="text-sm text-fg-muted">Texto de apoio em 14px.</p>
      </div>
    </Section>

    <Section tone="alt" aria-labelledby="botoes">
      <SectionHeading id="botoes" title="Botões" />
      <div class="flex flex-wrap items-center gap-3">
        <Button href="#botoes">Reservar um PC</Button>
        <Button variant="secondary">Secundário</Button>
        <Button variant="outline">Contorno</Button>
        <Button variant="ghost">Fantasma</Button>
        <Button variant="inverse">Inverso</Button>
        <Button disabled>Desativado</Button>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <Button size="lg" href="#botoes">
          <Icon name="whatsapp" /> Reservar pelo WhatsApp
        </Button>
        <Button size="lg" variant="outline" href="#botoes">
          Ver preços
        </Button>
      </div>
    </Section>

    <Section aria-labelledby="cartoes">
      <SectionHeading
        id="cartoes"
        title="Cartões"
        description="Com título de seção, descrição e link."
        link={{ href: '#cartoes', label: 'Ver todos' }}
      />
      <div class="grid gap-4 md:grid-cols-3">
        <Card as="article">
          <Tag>Sala Pro</Tag>
          <h3 class="text-2xl font-bold">Surface</h3>
          <p class="text-fg-soft">Padrão: fundo de superfície com borda.</p>
        </Card>
        <Card as="article" tone="raised">
          <Tag tone="accent">Popular</Tag>
          <h3 class="text-2xl font-bold">Raised</h3>
          <p class="text-fg-soft">Sem borda, um tom mais claro.</p>
        </Card>
        <Card as="article" tone="accent">
          <h3 class="text-2xl font-bold">Accent</h3>
          <p class="text-accent-tint">Para o destaque da seção, como o Corujão.</p>
          <Button variant="inverse" class="mt-auto">
            Reservar o Corujão
          </Button>
        </Card>
      </div>
    </Section>

    <Section tone="alt" aria-labelledby="outros">
      <SectionHeading id="outros" title="Avaliação, fotos e ícones" />
      <div class="grid gap-6 md:grid-cols-2">
        <Card>
          <Stars value={4.8} size={20} />
          <blockquote class="text-[17px] leading-relaxed text-fg-soft">
            “[Avaliação real do Google]”
          </blockquote>
        </Card>
        <Placeholder label="Foto da Sala Pro" class="min-h-48" />
      </div>
      <ul class="flex flex-wrap gap-3">
        {icones.map((nome) => (
          <li
            class="flex size-16 flex-col items-center justify-center gap-1 rounded-md bg-surface text-fg-soft"
            title={nome}
          >
            <Icon name={nome} />
          </li>
        ))}
      </ul>
    </Section>

    <Section aria-labelledby="conteudo">
      <SectionHeading
        id="conteudo"
        title="Conteúdo"
        description="Lido de src/content (issue #8): é isso que o painel vai editar."
      />
      <div class="overflow-x-auto rounded-lg border border-line">
        <table class="w-full min-w-[560px] border-collapse text-left">
          <thead class="text-sm text-fg-muted">
            <tr>
              <th scope="col" class="p-4 font-semibold">
                Plano
              </th>
              <th scope="col" class="p-4 font-semibold">
                Quando vale
              </th>
              {salas.map((s) => (
                <th scope="col" class="p-4 text-right font-semibold">
                  {s.data.nome}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {planos.map(({ id, data }) => (
              <tr class="border-t border-line">
                <th scope="row" class="p-4 font-semibold">
                  {data.nome}
                </th>
                <td class="p-4 text-fg-soft">
                  {data.janela
                    ? `${formatarHora(data.janela.inicio)} – ${formatarHora(data.janela.fim)}`
                    : 'Qualquer horário'}
                </td>
                {salas.map((s) => (
                  <td class="p-4 text-right font-bold" data-plano={id}>
                    {formatarPreco(data.precos[s.id as 'pro' | 'vip'], { inteiro: true })}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-fg-soft">
        A partir de {formatarPreco(aPartirDe.pro)}/h na Pro e {formatarPreco(aPartirDe.vip)}/h na
        VIP · {horarios.length} faixas de horário · {jogos.length} jogos (
        {jogos.filter((j) => j.data.popular).length} populares).
      </p>
    </Section>
  </main>
</Base>
