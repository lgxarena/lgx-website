---
/**
 * Pergunta com resposta recolhível, com `<details>` nativo: funciona sem JavaScript,
 * abre com Enter ou Espaço e o leitor de tela anuncia se está aberta ou fechada.
 *
 * A resposta abre e fecha deslizando (`::details-content` + `interpolate-size`). Navegador sem
 * suporte só abre e fecha, sem animação; com "reduzir movimento", também não anima.
 */
interface Props {
  pergunta: string
  aberta?: boolean
}

const { pergunta, aberta = false } = Astro.props
---

<details
  open={aberta}
  class="pergunta group rounded-lg bg-surface transition-colors open:bg-surface-2 motion-reduce:transition-none"
>
  <summary class="flex min-h-15 cursor-pointer list-none items-center justify-between gap-4 rounded-lg px-5 py-4 text-[17px] font-semibold [&::-webkit-details-marker]:hidden">
    {pergunta}
    <svg
      viewBox="0 0 24 24"
      width="20"
      height="20"
      aria-hidden="true"
      fill="none"
      stroke-width="2"
      stroke-linecap="round"
      class="shrink-0 stroke-fg-muted transition-transform group-open:rotate-45 motion-reduce:transition-none"
    >
      <path d="M12 5v14M5 12h14"></path>
    </svg>
  </summary>
  <div class="px-5 pb-5 text-[15px] leading-relaxed text-fg-soft [&_a]:font-semibold">
    <slot />
  </div>
</details>

<style>
  .pergunta {
    interpolate-size: allow-keywords;
  }

  .pergunta::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
    transition:
      block-size 300ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 200ms ease,
      content-visibility 300ms allow-discrete;
  }

  .pergunta[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .pergunta::details-content {
      transition: none;
    }
  }
</style>
