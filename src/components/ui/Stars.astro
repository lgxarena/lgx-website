---
interface Props {
  /** Nota de 0 a 5. Valores quebrados são arredondados para a estrela mais próxima. */
  value?: number
  size?: number
  class?: string
}

const { value = 5, size = 16, class: className } = Astro.props
const filled = Math.round(Math.min(5, Math.max(0, value)))
const label = `Nota ${String(value).replace('.', ',')} de 5`
const star = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z'
---

<span role="img" aria-label={label} class:list={['inline-flex gap-0.5', className]}>
  {[0, 1, 2, 3, 4].map((i) => (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      aria-hidden="true"
      class={i < filled ? 'fill-accent' : 'fill-surface-3'}
    >
      <path d={star} />
    </svg>
  ))}
</span>
