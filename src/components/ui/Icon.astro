---
/**
 * Ícones em SVG inline que herdam a cor do texto.
 * - Interface: traço de 2px, desenhados aqui.
 * - Marcas (redes sociais e WhatsApp): preenchidos, vindos do Simple Icons (CC0).
 * Decorativos por padrão; passe `label` quando o ícone for o único conteúdo com significado.
 */
import {
  siFacebook,
  siGithub,
  siInstagram,
  siTiktok,
  siTwitch,
  siWhatsapp,
  siYoutube,
} from 'simple-icons'

const marcas = {
  whatsapp: siWhatsapp.path,
  instagram: siInstagram.path,
  tiktok: siTiktok.path,
  twitch: siTwitch.path,
  youtube: siYoutube.path,
  facebook: siFacebook.path,
  github: siGithub.path,
} as const

const paths = {
  'chevron-left': '<path d="M15 18l-6-6 6-6"/>',
  'chevron-right': '<path d="M9 18l6-6-6-6"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'external-link':
    '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  'map-pin':
    '<path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  moon: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>',
  gamepad:
    '<rect x="2" y="6" width="20" height="12" rx="6"/><path d="M6 12h4M8 10v4M15 13h.01M18 11h.01"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  tag: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
  help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 4.9.8c0 1.7-2.4 2.2-2.4 3.7M12 17h.01"/>',
} as const

export type IconName = keyof typeof paths | keyof typeof marcas

interface Props {
  name: IconName
  size?: number
  label?: string
  class?: string
}

const { name, size = 20, label, class: className } = Astro.props
const ehMarca = name in marcas
const conteudo = ehMarca
  ? `<path d="${marcas[name as keyof typeof marcas]}"/>`
  : paths[name as keyof typeof paths]
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  {...(ehMarca
    ? { fill: 'currentColor' }
    : {
        fill: 'none',
        stroke: 'currentColor',
        'stroke-width': '2',
        'stroke-linecap': 'round',
        'stroke-linejoin': 'round',
      })}
  class:list={['shrink-0', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={conteudo}
/>
