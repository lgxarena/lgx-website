---
import type { HTMLAttributes } from 'astro/types'

type Variant = 'primary' | 'secondary' | 'outline' | 'ghost' | 'inverse'
type Size = 'md' | 'lg'

type Common = {
  variant?: Variant
  size?: Size
  /** Ocupa toda a largura disponível. */
  block?: boolean
  class?: string
}

/** Com `href` vira link (`<a>`); sem `href` vira `<button type="button">`. */
type Props =
  | (Common & Omit<HTMLAttributes<'a'>, 'class'> & { href: string })
  | (Common & Omit<HTMLAttributes<'button'>, 'class'> & { href?: undefined })

const {
  variant = 'primary',
  size = 'md',
  block = false,
  href,
  class: className,
  ...rest
} = Astro.props

const variants: Record<Variant, string> = {
  primary: 'bg-accent-strong text-white hover:bg-accent-deep hover:text-white',
  secondary: 'bg-surface-2 text-fg hover:bg-surface-3 hover:text-fg',
  outline: 'border border-line-strong text-fg hover:bg-surface hover:text-fg',
  ghost: 'text-fg hover:bg-surface hover:text-fg',
  inverse: 'bg-fg text-bg hover:bg-white hover:text-bg',
}

const sizes: Record<Size, string> = {
  md: 'min-h-12 px-5 text-[15px]',
  lg: 'min-h-14 px-8 text-[17px]',
}

const classes = [
  'inline-flex items-center justify-center gap-2 rounded-md font-semibold no-underline transition-colors',
  'disabled:cursor-not-allowed disabled:opacity-60',
  variants[variant],
  sizes[size],
  block && 'w-full',
  className,
]

const linkAttrs = rest as Omit<HTMLAttributes<'a'>, 'class'>
const buttonAttrs = rest as Omit<HTMLAttributes<'button'>, 'class'>
---

{href ? (
  <a {...linkAttrs} href={href} class:list={classes}>
    <slot />
  </a>
) : (
  <button type="button" {...buttonAttrs} class:list={classes}>
    <slot />
  </button>
)}
