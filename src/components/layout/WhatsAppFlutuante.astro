---
import Icon from '@/components/ui/Icon.astro'
import { getSite } from '@/lib/conteudo'
import { linkWhatsApp } from '@/lib/formatar'

const site = await getSite()
---

<a
  href={linkWhatsApp(site.whatsapp)}
  target="_blank"
  rel="noopener"
  class="fixed right-5 bottom-5 z-30 inline-flex size-14 items-center justify-center rounded-full bg-accent-strong text-white no-underline shadow-float transition-colors hover:bg-accent-deep hover:text-white sm:right-6 sm:bottom-6"
>
  <Icon name="whatsapp" size={26} label="Falar com a LGX no WhatsApp (abre em nova aba)" />
</a>
