---
/**
 * Horários de funcionamento com o status do momento ("Aberto agora · fecha às 22h").
 *
 * O site é estático, então o status e o destaque do dia são calculados no navegador, no fuso
 * de São Paulo. Sem JavaScript, a faixa mostra só os horários. Feriados não entram no cálculo
 * (o dia é tratado pelo dia da semana); o aviso do topo (`avisos`) cobre exceções.
 */
import Container from '@/components/ui/Container.astro'
import Icon from '@/components/ui/Icon.astro'
import { getHorarios } from '@/lib/conteudo'

const horarios = await getHorarios()

const notaCorujao = horarios.find((h) => h.data.dias.length === 0)?.data.observacao

const regulares = horarios
  .filter((h) => h.data.dias.length > 0)
  .map((h) => ({ dias: h.data.dias, abre: h.data.abre, fecha: h.data.fecha }))
---

<section aria-labelledby="horarios-titulo" class="border-y border-line bg-bg-alt py-10 md:py-12">
  <Container class="grid gap-8 lg:grid-cols-[minmax(0,15rem)_1fr] lg:items-center lg:gap-12">
    <div class="flex flex-col gap-3">
      <h2 id="horarios-titulo" class="text-2xl font-extrabold tracking-tight">
        Horários
      </h2>
      <p
        data-status
        hidden
        class="inline-flex items-center gap-2 self-start rounded-full bg-surface-2 px-3.5 py-1.5 text-sm font-semibold"
      >
        <span data-status-ponto class="size-2 rounded-full"></span>
        <span data-status-texto></span>
      </p>
    </div>

    <div class="flex flex-col gap-3">
      <dl class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {horarios.map((h) => {
          const corujao = h.data.dias.length === 0
          return (
            <div
              data-dias={h.data.dias.join(' ')}
              class:list={[
                'relative flex flex-col gap-1.5 rounded-lg border p-4 transition-colors md:p-5',
                corujao
                  ? 'border-accent-deep/60 bg-[linear-gradient(135deg,rgb(195_18_18/0.18),transparent_70%)]'
                  : 'border-line bg-surface data-hoje:border-fg/40 data-hoje:bg-surface-2',
              ]}
            >
              <dt class="flex items-center gap-2 text-sm text-fg-muted">
                {h.data.rotulo}
                {corujao && (
                  <Icon
                    name="moon"
                    size={18}
                    class="absolute top-4 right-4 text-link md:top-5 md:right-5"
                  />
                )}
                <span
                  data-selo-hoje
                  hidden
                  class="ml-auto rounded-sm bg-fg px-1.5 py-0.5 text-[11px] font-bold tracking-wide text-bg uppercase"
                >
                  Hoje
                </span>
              </dt>
              <dd class="text-lg font-bold tabular-nums md:text-xl">
                {h.data.abre} – {h.data.fecha}
              </dd>
            </div>
          )
        })}
      </dl>
      {notaCorujao && (
        <p class="flex items-center gap-2 text-[13px] text-fg-muted md:justify-end">
          <Icon name="moon" size={14} class="text-link" />
          Corujão: {notaCorujao.charAt(0).toLowerCase() + notaCorujao.slice(1)}.
        </p>
      )}
    </div>
  </Container>
</section>

<script
  is:inline
  type="application/json"
  id="horarios-dados"
  set:html={JSON.stringify(regulares)}
/>
<script>
  type Horario = { dias: string[]; abre: string; fecha: string }

  const dados = document.getElementById('horarios-dados')?.textContent
  const status = document.querySelector<HTMLElement>('[data-status]')

  if (dados && status) {
    const horarios: Horario[] = JSON.parse(dados)
    const dias = ['domingo', 'segunda', 'terca', 'quarta', 'quinta', 'sexta', 'sabado']

    // Dia e hora em São Paulo, independente do fuso de quem visita.
    const partes = Object.fromEntries(
      new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Sao_Paulo',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      })
        .formatToParts(new Date())
        .map((p) => [p.type, p.value])
    )
    const indiceHoje = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(partes.weekday)
    const agora = `${partes.hour}:${partes.minute}`

    const doDia = (indice: number) => horarios.find((h) => h.dias.includes(dias[indice % 7]))
    const hora = (hhmm: string) =>
      hhmm.endsWith(':00') ? `${hhmm.slice(0, 2)}h` : hhmm.replace(':', 'h')

    const hoje = doDia(indiceHoje)
    let aberto = false
    let texto = 'Fechado agora'

    if (hoje && agora >= hoje.abre && agora < hoje.fecha) {
      aberto = true
      texto = `Aberto agora · fecha às ${hora(hoje.fecha)}`
    } else if (hoje && agora < hoje.abre) {
      texto = `Fechado agora · abre às ${hora(hoje.abre)}`
    } else {
      const amanha = doDia(indiceHoje + 1)
      if (amanha) texto = `Fechado agora · abre amanhã às ${hora(amanha.abre)}`
    }

    const textoEl = status.querySelector('[data-status-texto]')
    const ponto = status.querySelector('[data-status-ponto]')
    if (textoEl) textoEl.textContent = texto
    if (ponto) {
      ponto.className = aberto
        ? 'size-2 rounded-full bg-[#3ddc84] shadow-[0_0_0_4px_rgb(61_220_132/0.2)]'
        : 'size-2 rounded-full bg-fg-subtle'
    }
    status.hidden = false

    const diaDeHoje = dias[indiceHoje]
    for (const bloco of document.querySelectorAll<HTMLElement>('[data-dias]')) {
      if (!bloco.dataset.dias?.split(' ').includes(diaDeHoje)) continue
      bloco.dataset.hoje = ''
      const selo = bloco.querySelector<HTMLElement>('[data-selo-hoje]')
      if (selo) selo.hidden = false
    }
  }
</script>
