---
import Container from '@/components/ui/Container.astro'
import { getHorarios } from '@/lib/conteudo'

const horarios = await getHorarios()
---

<section aria-labelledby="horarios-titulo" class="border-y border-line bg-bg-alt py-7">
  <Container class="flex flex-col gap-x-12 gap-y-4 sm:flex-row sm:items-center">
    <h2 id="horarios-titulo" class="text-[13px] font-bold tracking-widest text-fg-muted uppercase">
      Horários
    </h2>
    <dl class="grid flex-1 grid-cols-2 gap-x-8 gap-y-4 md:grid-cols-4">
      {horarios.map((h) => (
        <div>
          <dt class="text-[13px] text-fg-muted">{h.data.rotulo}</dt>
          <dd class="mt-0.5 text-[17px] font-bold tabular-nums">
            {h.data.abre} – {h.data.fecha}
          </dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
