---
import { Font } from 'astro:assets'

import Avisos from '@/components/layout/Avisos.astro'
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import Seo, { type SeoProps } from '@/components/layout/Seo.astro'
import WhatsAppFlutuante from '@/components/layout/WhatsAppFlutuante.astro'

import '@/styles/global.css'

type Props = SeoProps

const props = Astro.props
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...props} />
    <meta name="theme-color" content="#0e0e0e" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <Font cssVariable="--font-inter" preload />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#conteudo"
      class="sr-only z-50 rounded-md bg-fg px-4 py-3 font-semibold text-bg no-underline focus:not-sr-only focus:fixed focus:top-3 focus:left-3 hover:text-bg"
    >
      Pular para o conteúdo
    </a>
    <Avisos />
    <Header />
    <main id="conteudo" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <WhatsAppFlutuante />
  </body>
</html>
