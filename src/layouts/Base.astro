---
import { Font } from 'astro:assets'

import AvisoCookies from '@/components/layout/AvisoCookies.astro'
import Avisos from '@/components/layout/Avisos.astro'
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import Seo, { type SeoProps } from '@/components/layout/Seo.astro'
import { CLOUDFLARE_WEB_ANALYTICS } from '@/lib/config'
import { pwaInfo } from 'virtual:pwa-info'

import '@/styles/global.css'

type Props = SeoProps

const props = Astro.props
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...props} />
    <meta name="theme-color" content="#0e0e0e" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <slot name="head" />
    <Font cssVariable="--font-inter" preload />
    <meta name="generator" content={Astro.generator} />
    {CLOUDFLARE_WEB_ANALYTICS && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CLOUDFLARE_WEB_ANALYTICS })}
      />
    )}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#conteudo"
      class="sr-only z-50 rounded-md bg-fg font-semibold text-bg no-underline focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:px-4 focus:py-3 hover:text-bg"
    >
      Pular para o conteúdo
    </a>
    <Avisos />
    <Header />
    <main id="conteudo" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <AvisoCookies />
    <script>
      import { registerSW } from 'virtual:pwa-register'

      // Instala o service worker (app instalável e página offline). Atualiza sozinho.
      registerSW({ immediate: true })
    </script>
  </body>
</html>
